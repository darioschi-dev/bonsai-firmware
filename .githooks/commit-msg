#!/usr/bin/env bash
# atk-managed: commit-msg 95c116a8
# Regola del workspace: nessun riferimento ad assistenti o modelli automatici nei messaggi di commit (vedi AGENTS.md).
# Installato da `atk scaffold --hooks`, che imposta anche `git config core.hooksPath .githooks` (locale a ogni clone; lo controlla `atk doctor`).

set -euo pipefail

# Regola del workspace: nessun riferimento ad assistenti o modelli automatici
# nei messaggi di commit — né trailer, né firme, né menzioni nel corpo, di
# qualunque fornitore. Esiste perché la sola regola scritta non bastava: fino
# al 2026-09-23 ne erano finiti 77 nella history.
#
# Le righe di commento (`#`) non entrano nel commit e sono ignorate. I nomi di
# file del repository che contengono una di queste parole (CLAUDE.md,
# AGENTS.md, AGENT-ACTIVE.md, .agent/) si possono citare: sono percorsi, non
# riferimenti.
msg_file="$1"

body="$(grep -v '^#' "$msg_file" \
  | sed -E 's#(CLAUDE|AGENTS|AGENT-ACTIVE)\.md##g; s#\.agent/##g')"

# Nomi di fornitori, prodotti e modelli, senza distinzione di maiuscole.
names='claude|anthropic|opus|sonnet|haiku|fable|codex|openai|chatgpt|gpt(-[0-9a-z.]+)?|gemini|bard|antigravity|agy|copilot|cursor|windsurf|llm|llms|intelligenza artificiale|artificial intelligence'

matches="$(
  {
    printf '%s\n' "$body" | grep -inwE "$names" || true
    # AI/IA solo in maiuscolo: «ai» minuscolo è la preposizione italiana.
    printf '%s\n' "$body" | grep -nwE 'AI|IA' || true
    printf '%s\n' "$body" | grep -inE 'generated (with|by)|🤖' || true
  } | sort -t: -k1,1n -u
)"

if [[ -n "$matches" ]]; then
  echo "[commit-msg] Commit rifiutato: il messaggio non può contenere riferimenti ad assistenti o modelli automatici:" >&2
  printf '  riga %s\n' "$matches" >&2
  echo "[commit-msg] Rimuovere quei riferimenti e ripetere il commit." >&2
  exit 1
fi

# Collegamento commit–issue: l'indice contiene i file del commit, anche con
# directory sporca o `git commit --only`. --no-renames conta entrambi i lati
# di una rinomina, -z preserva spazi e ritorni a capo nei nomi.
subject="$(sed -n '/^[^#]/ { p; q; }' "$msg_file")"
exempt=false
case "$subject" in
  Merge\ *|Revert\ *|fixup\!*|squash\!*) exempt=true ;;
esac
merge_head="$(git rev-parse --git-path MERGE_HEAD)"
revert_head="$(git rev-parse --git-path REVERT_HEAD)"
if [[ -f "$merge_head" || -f "$revert_head" ]]; then
  exempt=true
fi

if [[ "$exempt" == false ]] && ! grep -E '#[0-9]+|senza issue' <<< "$body" > /dev/null; then
  # commit-msg riceve solo il file messaggio: il comando padre distingue
  # --amend, che Git non espone all'hook. Se il processo non è leggibile,
  # un riferimento esplicito evita di accettare una rettifica non verificata.
  if ! parent_args="$(ps -ww -p "$PPID" -o args= 2>/dev/null)" || [[ -z "$parent_args" ]]; then
    echo "[commit-msg] Impossibile distinguere commit e --amend: processo padre non leggibile." >&2
    echo "[commit-msg] Aggiungere #N oppure 'senza issue' (es. 'rettifica Refs #123')." >&2
    exit 1
  fi
  # ps non conserva la separazione degli argomenti: una menzione isolata
  # di --amend nel messaggio applica prudenzialmente il controllo più ampio.
  amend=false
  for option in --am --ame --amen --amend; do
    [[ " $parent_args " == *" $option "* ]] && amend=true
  done
  previous="HEAD"
  if [[ "$amend" == true ]]; then
    previous="$(git rev-parse --verify HEAD^ 2>/dev/null || git hash-object -t tree /dev/null)"
  elif ! git rev-parse --verify HEAD > /dev/null 2>&1; then
    previous="$(git hash-object -t tree /dev/null)"
  fi
  paths_file="$(mktemp)"
  trap 'rm -f "$paths_file"' EXIT
  if [[ "$amend" == true ]] && git rev-parse --verify HEAD^2 > /dev/null 2>&1; then
    : > "$paths_file"  # Anche una rettifica con titolo diverso resta un commit di merge.
  elif ! git diff --cached --name-only --no-renames -z "$previous" -- > "$paths_file"; then
    echo "[commit-msg] Impossibile verificare i file in stage; commit rifiutato." >&2
    exit 1
  fi
  while IFS= read -r -d '' path; do
    case "$path" in
      docs/*|.agent/*) continue ;;
      *.md) [[ "$path" != */* ]] && continue ;;
    esac
    echo "[commit-msg] Commit rifiutato: una modifica di codice richiede #N oppure la frase 'senza issue'." >&2
    echo "[commit-msg] Esempi: 'corregge il controllo Refs #123' oppure 'corregge il controllo — senza issue'." >&2
    exit 1
  done < "$paths_file"
  rm -f "$paths_file"
  trap - EXIT
fi

# Ora delle voci di registro: si legge con `date`, non si scrive a stima (regola «Mai inventare», ripetuta dal
# 2026-10-13). Le voci AGGIUNTE a `.agent/STATE.md` da questo commit devono avere un'ora non posteriore
# all'orologio e non più vecchia di tre ore. Una ricostruzione storica intenzionale lo dichiara con
# ATK_ALLOW_OLD_ENTRY=1; durante un rebase il controllo è saltato (le voci hanno la loro ora d'origine).
if [[ -f ".agent/STATE.md" ]] \
   && [[ ! -d "$(git rev-parse --git-path rebase-merge)" && ! -d "$(git rev-parse --git-path rebase-apply)" ]]; then
  added_headings="$(git diff --cached -U0 --no-renames -- .agent/STATE.md 2>/dev/null | grep -E '^\+## ' || true)"

  # Un heading con un comando `date` non espanso (`%F %H:%M` letterale) o con una data
  # inesistente nel calendario non supera nemmeno il controllo sull'orologio qui sotto, perché
  # non viene riconosciuto come data: va rifiutato esplicitamente (regola «Errori ripetuti»).
  malformed=""
  while IFS= read -r added; do
    [[ -z "$added" ]] && continue
    heading="${added:1}"
    if [[ "$heading" =~ %[A-Za-z] ]]; then
      malformed+="  ${heading:0:70}"$'\n'
      continue
    fi
    if [[ "$heading" =~ ^##\ ([0-9]{4})-([0-9]{2})-([0-9]{2})\ ([0-9]{2}):([0-9]{2}) ]]; then
      datestr="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]} ${BASH_REMATCH[4]}:${BASH_REMATCH[5]}"
      if ! date -j -f '%Y-%m-%d %H:%M' "$datestr" > /dev/null 2>&1 \
         && ! date -d "$datestr" > /dev/null 2>&1; then
        malformed+="  ${heading:0:70}"$'\n'
      fi
    else
      malformed+="  ${heading:0:70}"$'\n'
    fi
  done <<< "$added_headings"
  if [[ -n "$malformed" ]]; then
    echo "[commit-msg] Commit rifiutato: l'heading di una voce di .agent/STATE.md non ha una data valida (il comando \`date\` non è stato espanso, oppure la data non esiste nel calendario):" >&2
    printf '%s' "$malformed" >&2
    echo "[commit-msg] Esempio corretto: T=\$(date '+%Y-%m-%d %H:%M %Z') poi usare \$T nell'heading, mai scrivere %F o %H:%M a mano." >&2
    exit 1
  fi

  # Correzione di una voce esistente (regola «Registro agenti»): si possono correggere refusi di date, nomi, importi,
  # percorsi, mai cambiare significato; il commit che tocca righe di una voce esistente aggiunge nello stesso
  # commit una voce NUOVA che contiene la parola «Rettifica» (cosa è stato corretto, da quale valore a quale), e una
  # voce intera non si cancella. Una voce modificata nell'heading si riconosce dal suo `id:` (o dal testo dopo l'ora).
  state_diff="$(git diff --cached -U0 --no-renames -- .agent/STATE.md 2>/dev/null | awk '/^@@/{h=1} h' || true)"
  added_all="$(grep -E '^\+' <<< "$state_diff" | sed 's/^+//' | grep -vE '^[[:space:]]*$' || true)"
  removed_eff="$(grep -E '^-' <<< "$state_diff" | sed 's/^-//' | grep -vE '^[[:space:]]*$' | grep -vxFf <(printf '%s\n' "$added_all") || true)"
  if [[ -n "$removed_eff" ]]; then
    entry_key() { if [[ "$1" == *"id: "* ]]; then printf '%s' "${1##*id: }"; else printf '%s' "${1:19}"; fi; }
    added_keys=""
    while IFS= read -r l; do
      [[ "$l" == "## "* ]] && added_keys+="$(entry_key "$l")"$'\n'
    done <<< "$added_all"
    removed_keys=""
    deleted=""
    while IFS= read -r l; do
      [[ "$l" == "## "* ]] || continue
      k="$(entry_key "$l")"
      removed_keys+="$k"$'\n'
      grep -qxF -- "$k" <<< "$added_keys" || deleted+="  ${l:0:70}"$'\n'
    done <<< "$removed_eff"
    if [[ -n "$deleted" ]]; then
      echo "[commit-msg] Commit rifiutato: una voce di .agent/STATE.md non si può cancellare (storia append-only); si rettifica con una voce nuova:" >&2
      printf '%s' "$deleted" >&2
      exit 1
    fi
    rettifica_ok=""
    new_entry=""
    while IFS= read -r l; do
      case "$l" in
        @@*) new_entry="" ;;
        "+## "*)
          if grep -qxF -- "$(entry_key "${l:1}")" <<< "$removed_keys"; then new_entry=""; else new_entry=1; fi ;;
        "+"*)
          if [[ -n "$new_entry" && "$l" == *[Rr]ettifica* ]]; then rettifica_ok=1; fi ;;
      esac
    done <<< "$state_diff"
    if [[ -z "$rettifica_ok" ]]; then
      echo "[commit-msg] Commit rifiutato: il commit modifica il testo di una voce esistente di .agent/STATE.md senza aggiungere una voce nuova di Rettifica (la parola «Rettifica» nel testo, con cosa è stato corretto, da quale valore a quale)." >&2
      exit 1
    fi
  fi

  if [[ -z "${ATK_ALLOW_OLD_ENTRY:-}" ]]; then
    now="$(date '+%Y-%m-%d %H:%M')"
    floor="$(date -v-180M '+%Y-%m-%d %H:%M' 2>/dev/null || date -d '180 minutes ago' '+%Y-%m-%d %H:%M')"
    wrong=""
    while IFS= read -r added; do
      [[ -z "$added" ]] && continue
      stamp="${added:4:16}"
      if [[ "$stamp" > "$now" || "$stamp" < "$floor" ]]; then
        wrong+="  ${added:1:70}"$'\n'
      fi
    done <<< "$(grep -E '^\+## [0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}' <<< "$added_headings" || true)"
    if [[ -n "$wrong" ]]; then
      echo "[commit-msg] Commit rifiutato: l'ora di una voce di .agent/STATE.md non coincide con l'orologio (adesso: $now):" >&2
      printf '%s' "$wrong" >&2
      echo "[commit-msg] L'ora va letta con \`date\` nello stesso comando che scrive la voce (T=\$(date '+%Y-%m-%d %H:%M %Z')), non stimata. Correggere l'heading; per una ricostruzione storica: ATK_ALLOW_OLD_ENTRY=1 git commit ..." >&2
      exit 1
    fi
  fi
fi

# Prossimo passo senza scheda (issue #33, regola «Errori ripetuti»): una voce NUOVA di `.agent/STATE.md` il cui «Prossimo passo o blocchi» è
# un'azione senza scheda né issue lascia il lavoro solo nel diario, dove sparisce dai brief. Il controllo è in `atk context diario-check`
# (solo voci aggiunte da questo commit, solo repository con schede). Blocca solo l'exit 1 (azione non collegata ad alcuna scheda; se la
# voce nomina una scheda aperta ma non scrive «vedi scheda <id>» è un avviso con l'id da scrivere); un altro esito (atk vecchio o rotto)
# avvisa e lascia passare: un hook che si rompe non deve fermare ogni commit. Durante un rebase è saltato come i controlli sopra.
if [[ -f ".agent/STATE.md" ]] \
   && [[ ! -d "$(git rev-parse --git-path rebase-merge)" && ! -d "$(git rev-parse --git-path rebase-apply)" ]] \
   && ! git diff --cached --quiet -- .agent/STATE.md 2>/dev/null; then
  if ! command -v atk >/dev/null 2>&1; then
    echo "[commit-msg] atk non trovato: controllo diario-check (prossimo passo senza scheda) saltato" >&2
  else
    diario_status=0
    diario_out="$(atk context diario-check --staged --root "$PWD" 2>&1)" || diario_status=$?
    if [[ "$diario_status" -eq 1 ]]; then
      echo "[commit-msg] Commit rifiutato: una voce nuova di .agent/STATE.md ha un prossimo passo senza scheda." >&2
      printf '%s\n' "$diario_out" >&2
      exit 1
    elif [[ "$diario_status" -ne 0 ]]; then
      echo "[commit-msg] atk context diario-check non è riuscito (esito $diario_status), controllo saltato:" >&2
      printf '%s\n' "$diario_out" >&2
    elif [[ -n "$diario_out" ]]; then
      echo "[commit-msg] Avviso (il commit prosegue): manca il rimando alla scheda nel prossimo passo di una voce nuova." >&2
      printf '%s\n' "$diario_out" >&2
    fi
  fi
fi

# Composizione con un hook proprio del repository: `atk scaffold --hooks --adopt-hook` sposta qui accanto il
# `commit-msg` preesistente come `commit-msg.local`, che gira dopo questo controllo (il suo esito decide il commit).
local_hook="$(dirname "$0")/commit-msg.local"
if [[ -x "$local_hook" ]]; then
  exec "$local_hook" "$@"
fi
